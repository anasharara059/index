{
  "name": "index-study-timer-desktop",
  "version": "1.0.0",
  "description": "INDEX Study Assistant with an always-on-top desktop timer",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "build": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.index.studyassistant",
    "productName": "INDEX Study Assistant",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "overlay.html"
    ],
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "release"
    }
  }
}
